# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit your actual token.

# Get yours at https://app.localstack.cloud  (Auth Tokens)
LOCALSTACK_AUTH_TOKEN=ls-your-token-here

# S3 / AWS config used by ingestion scripts
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=ecommerce-data

# PostgreSQL (used by load_postgres.py and Streamlit UI)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=your-postgres-password-here
